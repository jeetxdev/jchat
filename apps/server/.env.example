# Port the API listens on (defaults to 3001)
PORT=3001
NODE_ENV=development

# Postgres — your database connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jchat"
DATABASE_URL_POOLED="postgresql://postgres:postgres@localhost:5432/jchat"
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT=5000
DB_IDLE_TIMEOUT=5000

# JWT secret — used to sign and verify tokens
JWT_SECRET="" # e.g. secret key
