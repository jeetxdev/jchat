{
  "name": "@jchat/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "npm run typecheck && node esbuild.config.mjs",
    "start": "node --enable-source-maps --env-file=.env dist/index.js",
    "lint": "eslint .",
    "test:watch": "vitest",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@jchat/shared": "*",
    "drizzle-orm": "^1.0.0-rc.5",
    "express": "^5.1.0",
    "libphonenumber-js": "^1.13.13",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.4",
    "drizzle-kit": "^1.0.0-rc.5",
    "esbuild": "0.28.2",
    "supertest": "^7.3.1",
    "tsx": "^4.20.6",
    "vitest": "^5.0.4"
  }
}
