    "express": "^5.1.0",
    "libphonenumber-js": "^1.13.13",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.4",
    "supertest": "^7.3.1",
    "tsx": "^4.20.6",
    "vitest": "^5.0.4"
  }
}
